meta {
  name: Create Incident 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/incidents
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "projectId": 4,
    "serviceId": 1,
    "title": "Database connection failure",
    "description": "Production API is unable to connect to PostgreSQL",
    "severity": "CRITICAL",
    "status": "OPEN"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
